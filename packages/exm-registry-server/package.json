{
  "name": "@bsgames/exm-registry-server",
  "version": "0.0.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrinktofit/exm.git",
    "directory": "packages/exm-registry-server"
  },
  "files": [
    "bin/exm-registry-server.js",
    "lib/**/*{.js,.d.ts}",
    "exm-registry-server.example.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "bin": {
    "exm-registry-server": "./bin/exm-registry-server.js"
  },
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "node --run build -- --clean && node --run build",
    "start": "node ./bin/exm-registry-server.js",
    "test": "node --run test:compile && node --run t",
    "test:compile": "tsc -b test/tsconfig.json",
    "t": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "semver": "^7.7.2",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@bsgames/workflow": "workspace:*"
  }
}
